# Only safe placeholders. Copy to an untracked .env and replace every value.
POSTGRES_DB=nakama_docker
POSTGRES_USER=nakama
POSTGRES_PASSWORD=replace-with-a-long-unique-password
ConnectionStrings__NakamaDatabase=Host=postgres;Port=5432;Database=nakama_docker;Username=nakama;Password=replace-with-a-long-unique-password;SSL Mode=Disable
Authentication__Jwt__SigningKey=generate-at-least-32-random-bytes-with-scripts-Generate-NakamaSecrets.ps1
Authentication__Jwt__Issuer=https://api.example.com
Authentication__Jwt__Audience=https://api.example.com
Authentication__Jwt__AccessTokenMinutes=60
Cors__AllowedOrigins__0=https://nakama.example.com
AllowedHosts=api.example.com
Attachments__StoragePath=/data/attachments
VITE_API_BASE_URL=https://api.example.com
